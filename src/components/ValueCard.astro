---
interface Props {
  num: string;
  title: string;
  blurb: string;
}

const { num, title, blurb } = Astro.props;
---

<div class="value-card">
  <span class="value-num">{num}</span>
  <h3 class="value-title">{title}</h3>
  <p class="value-blurb">{blurb}</p>
</div>

<style>
  .value-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--sage);
  }
  .value-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 28px;
    color: var(--green-deep);
    margin-top: 10px;
  }
  .value-blurb {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-body);
    font-weight: 300;
  }
</style>
