---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <nav class="container nav">
    <a href="/" class="wordmark" aria-label="IPS home">
      <span class="wordmark-ips">IPS</span>
      <span class="wordmark-rule"></span>
      <span class="wordmark-full">Innovative<br />People Solutions</span>
    </a>

    <div class="nav-right">
      <div class="nav-links">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))}
      </div>
      <a href="/contact" class="btn nav-cta">Book a Consultation</a>
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={['mobile-link', { active: isActive(item.href) }]}
      >
        {item.label}
      </a>
    ))}
    <a href="/contact" class="btn mobile-cta">Book a Consultation</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 245, 237, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav {
    padding: 18px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--green);
  }
  .wordmark:hover {
    color: var(--green);
  }
  .wordmark-ips {
    font-family: 'Cormorant Garamond', serif;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--green);
    line-height: 1;
  }
  .wordmark-rule {
    width: 1px;
    height: 30px;
    background: rgba(58, 77, 60, 0.25);
    flex-shrink: 0;
  }
  .wordmark-full {
    font-size: 9.5px;
    letter-spacing: 3px;
    color: var(--text-muted);
    text-transform: uppercase;
    line-height: 1.5;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-link {
    padding: 8px 14px;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: color 0.2s;
  }
  .nav-link:hover {
    color: var(--green);
  }
  .nav-link.active {
    color: var(--green);
    border-bottom: 1px solid var(--sage);
  }
  .nav-cta {
    margin-left: 14px;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
  }
  .hamburger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--green-deep);
    transition: transform 0.25s, opacity 0.25s;
  }
  .hamburger.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 8px 24px 24px;
    border-top: 1px solid var(--hairline);
    background: var(--bg);
  }
  .mobile-menu.open {
    display: flex;
  }
  .mobile-link {
    padding: 14px 4px;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--hairline);
  }
  .mobile-link.active {
    color: var(--green);
  }
  .mobile-cta {
    margin-top: 16px;
    width: 100%;
    padding: 14px;
  }

  @media (max-width: 860px) {
    .nav {
      padding: 16px 24px;
    }
    .wordmark-full {
      display: none;
    }
    .nav-links,
    .nav-cta {
      display: none;
    }
    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    hamburger.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('open');
      mobileMenu?.classList.remove('open');
    });
  });
</script>
