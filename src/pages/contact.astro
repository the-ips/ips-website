---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/content';
---

<Layout title="Contact" description="Book a free consultation with Innovative People Solutions.">
  <section class="container contact-grid">
    <div>
      <div class="eyebrow">
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Get in touch</span>
      </div>
      <h1 class="contact-h1">Book a consultation.</h1>
      <p class="contact-p">
        Tell us a little about your team and where you need help. We'll get back
        within one business day to set up a free 30-minute call.
      </p>
      <div class="contact-details">
        <div>
          <div class="contact-label">Email</div>
          <a href={`mailto:${contact.email}`} class="contact-value">{contact.email}</a>
        </div>
      </div>
    </div>

    <div class="contact-panel">
      <form id="contactForm" class="contact-form">
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" required type="text" placeholder="Jane Doe" />
        </div>
        <div class="field">
          <label for="cf-company">Company</label>
          <input id="cf-company" name="company" type="text" placeholder="Acme Inc." />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" required type="email" placeholder="jane@acme.com" />
        </div>
        <div class="field">
          <label for="cf-message">How can we help?</label>
          <textarea
            id="cf-message"
            name="message"
            rows="4"
            placeholder="We're hiring fast and need help with..."
          ></textarea>
        </div>
        <button type="submit" class="btn submit-btn">Send Message</button>
      </form>

      <div id="successPanel" class="success-panel" hidden>
        <span class="success-check">✓</span>
        <h3 class="success-h3">Thank you.</h3>
        <p class="success-p">
          Your email client should have opened with a pre-filled message — hit send
          there and we'll be in touch within one business day.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    padding: 88px 40px 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .contact-h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 60px;
    line-height: 1.03;
    letter-spacing: -1px;
    color: var(--green-deep);
  }
  .contact-p {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-body);
    font-weight: 300;
    max-width: 420px;
  }
  .contact-details {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .contact-label {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sage);
  }
  .contact-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    color: var(--green-deep);
  }

  .contact-panel {
    background: var(--card);
    border: 1px solid var(--hairline-strong);
    border-radius: 4px;
    padding: 44px;
  }
  .contact-form[hidden] {
    display: none;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .field label {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .field input,
  .field textarea {
    width: 100%;
    margin-top: 8px;
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--hairline-strong);
    border-radius: 2px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    color: var(--text-ink);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--sage);
  }
  .submit-btn {
    margin-top: 6px;
    width: 100%;
    padding: 15px;
  }

  .success-panel {
    min-height: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
  }
  .success-panel[hidden] {
    display: none;
  }
  .success-check {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #dfe4d8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--green);
    font-size: 28px;
  }
  .success-h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 32px;
    color: var(--green-deep);
  }
  .success-p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-body);
    font-weight: 300;
    max-width: 280px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 64px 24px 72px;
    }
    .contact-h1 {
      font-size: 40px;
    }
    .contact-panel {
      padding: 28px 24px;
    }
  }
</style>

<script define:vars={{ email: contact.email }}>
  const form = document.getElementById('contactForm');
  const successPanel = document.getElementById('successPanel');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = document.getElementById('cf-name').value.trim();
    const company = document.getElementById('cf-company').value.trim();
    const emailField = document.getElementById('cf-email').value.trim();
    const message = document.getElementById('cf-message').value.trim();

    const subject = encodeURIComponent(`Consultation request from ${name}`);
    const bodyLines = [
      `Name: ${name}`,
      company ? `Company: ${company}` : null,
      `Email: ${emailField}`,
      '',
      message,
    ].filter((line) => line !== null);
    const body = encodeURIComponent(bodyLines.join('\n'));

    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

    form.hidden = true;
    successPanel.hidden = false;
  });
</script>
