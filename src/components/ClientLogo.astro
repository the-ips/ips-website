---
interface Props {
  name: string;
  src: string;
}

const { name, src } = Astro.props;
---

<img src={src} alt={name} class="client-logo" />

<style>
  .client-logo {
    height: 30px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.92;
  }
</style>
